{
  "name": "aloft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "smoke": "node tools/capture/smoke.mjs captures/smoke.png",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && node scripts/check-no-em-dash.mjs",
    "lint:dash": "node scripts/check-no-em-dash.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "capture": "node tools/capture/capture.mjs",
    "test:gpu": "node tools/capture/gpu-tests.mjs",
    "baseline": "node tools/capture/baseline.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jpeg-js": "0.4.4",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
